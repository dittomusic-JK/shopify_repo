---
const { theme, index = 0, delay = '' } = Astro.props;
const num = String(index).padStart(2, '0');
const buyHref = theme.buy || '#crew';
const buyLabel = theme.buy ? (theme.free ? 'Get it free' : 'Get it') : 'Notify me';
const demoAttrs = theme.external ? { target: '_blank', rel: 'noopener' } : {};
---
<article class={`reveal ${delay} theme-card group relative bg-card border-[2.5px] border-ink rounded-[16px] overflow-hidden flex flex-col`}>
  <span class="theme-card__glare" aria-hidden="true"></span>
  <a href={theme.demo} {...demoAttrs} class="relative block aspect-[3/4] overflow-hidden bg-ink-2 border-b-[2.5px] border-ink" aria-label={`View the ${theme.name} demo`}>
    <img src={`/shots/${theme.slug}.jpg`} alt="" width="640" height="853" loading="lazy" decoding="async" class="shot-img w-full h-full object-cover" />
    <span class="shot-hint absolute bottom-3 right-3 z-[2] flex items-center gap-1 bg-ink text-paper text-[.58rem] font-semibold uppercase tracking-[.12em] px-2 py-1 rounded-full">
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      Scroll
    </span>
    {theme.tag && (
      <span class="sticker absolute top-3 left-3">{theme.tag}</span>
    )}
  </a>
  <div class="p-[1.1rem] pb-5 flex flex-col flex-1 text-ink">
    <div class="flex items-baseline justify-between gap-3">
      <span class="num-outline text-[1.5rem]" aria-hidden="true">{num}</span>
      <span class={`font-display text-[1rem] tracking-[.04em] uppercase ${theme.free ? 'text-[#1f8f5a]' : 'text-spot-deep'}`}>{theme.price}</span>
    </div>
    <h3 class="font-display text-[1.55rem] uppercase leading-none mt-1">{theme.name}</h3>
    <div class="flex flex-wrap gap-1.5 mt-2.5">
      {theme.genre.split('·').map((g) => <span class="vibe-chip">{g.trim()}</span>)}
    </div>
    <p class="text-muted text-[.9rem] mt-3 mb-[1.15rem] flex-1 leading-[1.55]">{theme.blurb}</p>
    <div class="flex gap-2">
      <a href={theme.demo} {...demoAttrs} class="btn btn-line btn-sm flex-1 justify-center">View demo</a>
      <a href={buyHref} class="btn btn-ink btn-sm flex-1 justify-center">{buyLabel}</a>
    </div>
  </div>
</article>
