---
// Mixed-face ticker: display caps alternating with the funk face, like a
// sleeve credit that keeps moving. Paused on hover; static for reduced motion.
const items = [
  'All your music in one site', 'merch, tour dates & press kit', 'Sell on Spotify',
  'no code, no developer', 'A site you actually own', 'made for musicians',
];
---
<div class="marquee overflow-hidden py-3 relative z-[2]" aria-hidden="true">
  <div class="marquee-track">
    {[0, 1].map(() => (
      <div class="mg">
        {items.map((t, i) => (
          <>
            <span class={`px-4 ${i % 2 ? 'mg__funk' : ''}`}>{t}</span>
            <span class="px-1 opacity-45 text-[.8rem]">✦</span>
          </>
        ))}
      </div>
    ))}
  </div>
</div>
