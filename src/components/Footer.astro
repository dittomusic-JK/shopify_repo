---
---
<footer id="contact" class="site-footer ink-block relative overflow-hidden">
  <div class="max-w-[1180px] mx-auto px-5 sm:px-10 pt-14 pb-6 relative z-[2]">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1.6fr] pb-12 border-b border-paper/15">
      <div>
        <a href="/" class="logo logo--lg"><img src="/logo-tape-200-inverse.png" alt="Riffride" width="615" height="200" loading="lazy" decoding="async" /></a>
        <p class="text-muted text-[.9rem] mt-4 max-w-[30ch] leading-[1.6]">Shopify themes built for artists &amp; musicians. The quick path to selling merch — on your site and on Spotify.</p>
      </div>
      <div>
        <h5 class="foot-head">Site</h5>
        <a href="/#themes" class="foot-link">Themes</a>
        <a href="/#toolkit" class="foot-link">The toolkit</a>
        <a href="/setup" class="foot-link">Setup guide</a>
        <a href="/help" class="foot-link">Help &amp; tutorials</a>
        <a href="/support" class="foot-link">Support</a>
      </div>
      <div>
        <h5 class="foot-head">Start</h5>
        <a href="/#themes" class="foot-link">Get the free theme</a>
        <a href="https://c1rh1i-fs.myshopify.com" target="_blank" rel="noopener" class="foot-link">See the live demo</a>
        <a href="/setup" class="foot-link">Sell merch on Spotify</a>
      </div>
      <div id="crew">
        <h5 class="foot-head">Join the crew</h5>
        <p class="text-muted text-[.9rem] mb-3 leading-[1.6]">New themes, drops and one-line tips for selling your music. No spam, unsubscribe any time.</p>
        <form class="crew-form flex gap-2" data-crew-form action="https://formsubmit.co/james.keane@dittomusic.com" method="POST">
          <input type="hidden" name="_subject" value="Riffride crew signup" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <label class="flex-1 min-w-0">
            <span class="sr-only">Email</span>
            <input required type="email" name="email" placeholder="your@email.com" autocomplete="email" class="crew-input" />
          </label>
          <button class="btn btn-spot" type="submit">Join</button>
        </form>
        <p class="crew-msg" data-crew-msg role="status" aria-live="polite" hidden></p>
      </div>
    </div>
    <div class="pt-5 flex justify-between flex-wrap gap-2 text-muted text-[.8rem]">
      <span>© 2026 Riffride · Made in Manchester for artists &amp; musicians.</span>
      <span>Themes run on Shopify. From ~$5/mo.</span>
    </div>
  </div>
  <p class="foot-mark" aria-hidden="true">Riffride</p>
</footer>
