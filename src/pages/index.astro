---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Marquee from '../components/Marquee.astro';
import ThemeCard from '../components/ThemeCard.astro';
import Footer from '../components/Footer.astro';
import { themes } from '../data/themes.js';

const flagship = themes.find((t) => t.flagship);
const lineup = themes.filter((t) => !t.flagship);

const headline = ['Shopify', 'themes', 'for', 'musicians'];
// back to front — the flagship lands last, on top

const features = [
  { name: 'Storefront', desc: 'A full Shopify store — cart drawer, checkout and secure payments, built in.' },
  { name: 'Spotify embed', desc: 'Embed your latest release and let fans play it right on the page.' },
  { name: 'Discography', desc: 'Every album and single with full artwork, tracklists and preview clips.' },
  { name: 'Tour dates', desc: 'Shows with venues, ticket links and sold-out states that look sold out.' },
  { name: 'Release countdown', desc: 'A clock to the drop, in monumental numerals, that turns into "out now".' },
  { name: 'EPK builder', desc: 'A press-ready electronic press kit for blogs, promoters and labels.' },
  { name: 'On-demand merch', desc: 'Print-on-demand via Printful, Printify and Gelato — no stock to hold.' },
  { name: 'Galleries & films', desc: 'Editorial galleries, lookbooks and click-to-play video pages.' },
  { name: 'Links and socials', desc: 'Every platform — Spotify, Apple, Bandcamp, Instagram, TikTok and more.' },
];

const proof = [
  { src: '/gatefold/cart-drawer.jpg', label: 'Cart drawer', note: 'opens in place, ruled like a sleeve' },
  { src: '/gatefold/countdown.jpg', label: 'Release countdown', note: 'to the second, then "out now"' },
  { src: '/gatefold/search.jpg', label: 'Search takeover', note: 'results as you type' },
  { src: '/gatefold/pdp-tee.jpg', label: 'Product page', note: 'variant chips, sold-out states' },
  { src: '/gatefold/fan.jpg', label: 'The catalogue', note: 'covers deal out as you scroll' },
  { src: '/gatefold/tour.jpg', label: 'Tour dates', note: 'ruled rows, ticket links' },
];

const faqs = [
  { q: 'Do I need a Shopify account?', a: 'Yes — the themes run on Shopify, with plans from around $5/month. The free theme works on any plan, and the built-in setup guide points you to the right one.' },
  { q: 'How do I install a theme?', a: 'You get a .zip file plus a step-by-step setup guide built right into the theme. Upload it in your Shopify admin, follow the guide, and you\'re live — usually the same day.' },
  { q: 'What\'s the difference between free and paid?', a: 'The free Standard theme has everything you need to launch and sell. The $50 themes are bespoke designs with extra polish and premium-only sections, and they remove the "Created with Riffride" credit.' },
  { q: 'Can I really sell merch on Spotify?', a: 'Yes. Connect your Shopify store to Spotify for Artists and your merch shows on your artist profile, release pages and Now Playing. The setup guide walks you through every step.' },
  { q: 'When can I buy Soundcheck?', a: 'It\'s with the Shopify Theme Store for review. Join the crew below and you\'ll get one email the day it goes live — nothing else.' },
];
---
<Base>
  <Header />

  <!-- HERO — the real product as the object -->
  <section id="top" class="hero relative overflow-hidden bg-paper">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-10 pt-[clamp(3rem,7vw,5.5rem)] pb-[clamp(3.5rem,8vw,7rem)] grid lg:grid-cols-[1.05fr_.95fr] gap-x-14 gap-y-12 items-center relative z-[2]">
      <div>
        <p class="kicker hero-kicker">Eight themes · one free · for the Shopify musician</p>
        <h1 class="hero-headline mt-4">
          {headline.map((w, i) => (
            <span class={`w ${i >= 2 ? 'is-spot' : ''}`} style={`--i:${i}`}>{w}</span>
          ))}
        </h1>
        <p class="hero-sub mt-6 text-[clamp(1.02rem,1.5vw,1.2rem)] text-[#3f3a4d] max-w-[42ch] leading-[1.6]">Music, merch, tour dates, press kit and links in one site you own and build yourself. No code, no developer. You can even sell your merch on Spotify.</p>
        <div class="hero-cta flex flex-wrap gap-3.5 mt-8">
          <a href="#themes" class="btn btn-spot">See the themes</a>
          <a href="/setup" class="btn btn-ghost">Start free</a>
        </div>
        <p class="hero-note mt-7 text-[.82rem] text-muted">Front of the crate: <a href={flagship.demo} target="_blank" rel="noopener" class="text-ink font-semibold underline underline-offset-4 decoration-spot hover:text-spot-deep transition">Soundcheck</a>, our flagship, dressed as the demo band GATEFOLD.</p>
      </div>

      <div class="collage" aria-hidden="true">
        <div class="collage__col collage__col--a">
          <img src="/thumbs/static.jpg" alt="" width="543" height="760" class="collage__card" style="--i:0" decoding="async" />
          <img src="/thumbs/wander.jpg" alt="" width="543" height="760" class="collage__card" style="--i:3" decoding="async" />
        </div>
        <div class="collage__col collage__col--b">
          <img src="/thumbs/soundcheck.jpg" alt="" width="543" height="760" class="collage__card collage__card--flag" style="--i:1" fetchpriority="high" decoding="async" />
          <img src="/thumbs/vesper.jpg" alt="" width="543" height="760" class="collage__card collage__card--wide" style="--i:5" decoding="async" />
        </div>
        <div class="collage__col collage__col--c">
          <img src="/thumbs/riot.jpg" alt="" width="543" height="760" class="collage__card" style="--i:2" decoding="async" />
          <img src="/thumbs/block.jpg" alt="" width="543" height="760" class="collage__card" style="--i:4" decoding="async" />
        </div>
        <img src="/logo-roundel.png" alt="" width="430" height="424" class="collage__stamp" decoding="async" />
      </div>
    </div>
  </section>

  <Marquee />

  <!-- THEMES — flagship first, then the line-up as a numbered index -->
  <section id="themes" class="bg-paper text-ink py-[clamp(3.5rem,8vw,6.5rem)]">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-10">
      <div class="section-head">
        <div>
          <p class="kicker">01 — The themes</p>
          <h2 class="head-reveal font-funk text-[clamp(2rem,5vw,3.6rem)] leading-[1.02] mt-3">Pick a look. <span class="text-spot">Make it yours.</span></h2>
        </div>
        <p class="reveal section-head__intro">Every one is a complete musician website, not a template with a logo swapped in. Hover a card to scroll its demo; open it to click around.</p>
      </div>

      <!-- flagship -->
      <article class="reveal flagship">
        <a href={flagship.demo} target="_blank" rel="noopener" class="flagship__media" aria-label="Open the Soundcheck live demo">
          <img src="/shots/soundcheck.jpg" alt="" width="800" height="2560" loading="lazy" decoding="async" class="shot-img" />
          <span class="sticker sticker--spot absolute top-4 left-4">Flagship</span>
          <span class="shot-hint absolute bottom-3 right-3 z-[2] flex items-center gap-1 bg-ink text-paper text-[.58rem] font-semibold uppercase tracking-[.12em] px-2 py-1 rounded-full">Scroll</span>
        </a>
        <div class="flagship__body">
          <div class="flex items-baseline justify-between gap-3">
            <span class="num-outline text-[2rem]" aria-hidden="true">00</span>
            <span class="font-display text-[1rem] tracking-[.04em] uppercase text-spot-deep">{flagship.price} <span class="text-muted">· {flagship.priceNote}</span></span>
          </div>
          <h3 class="font-funk text-[clamp(1.8rem,4vw,2.8rem)] leading-none mt-1">{flagship.name}</h3>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {flagship.genre.split('·').map((g) => <span class="vibe-chip">{g.trim()}</span>)}
          </div>
          <p class="text-muted text-[1rem] mt-4 leading-[1.6] max-w-[52ch]">{flagship.blurb}</p>
          <ul class="flagship__facts">
            <li><b>Video wordmark hero</b> that fits any band name</li>
            <li><b>Cart drawer, countdown, track previews</b> — no apps</li>
            <li><b>axe clean</b> across every template, on every colour scheme</li>
          </ul>
          <div class="flex flex-wrap gap-2 mt-6">
            <a href={flagship.demo} target="_blank" rel="noopener" class="btn btn-ink">Open the live demo</a>
            <a href="#crew" class="btn btn-line">Notify me</a>
          </div>
        </div>
      </article>

      <div class="theme-grid">
        {lineup.map((t, i) => <ThemeCard theme={t} index={i + 1} delay={'d' + Math.min(i, 6)} />)}
        <article class="reveal d6 custom-card ink-block">
          <span class="num-outline text-[1.5rem]" aria-hidden="true">08</span>
          <h3 class="font-funk text-[clamp(1.4rem,2.4vw,1.8rem)] leading-[1.05] mt-2">Something <span class="text-spot">else?</span></h3>
          <p class="text-muted text-[.92rem] mt-3 leading-[1.55] flex-1">A colourway of any theme, a custom build, or a hand with the setup. Say what you're after and we'll come back within two business days.</p>
          <a href="/support" class="btn btn-spot btn-sm self-start mt-5">Talk to us</a>
        </article>
      </div>
    </div>
  </section>

  <!-- TOOLKIT — proof first, then the index -->
  <section id="toolkit" class="ink-block py-[clamp(4rem,9vw,7rem)] overflow-hidden">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-10">
      <div class="section-head">
        <div>
          <p class="kicker">02 — The toolkit</p>
          <h2 class="head-reveal font-funk text-[clamp(2rem,5.4vw,3.9rem)] leading-[1] mt-3">Everything's <span class="text-spot">included</span></h2>
        </div>
        <p class="reveal section-head__intro text-muted">Free or premium, every Riffride theme ships with the full kit. No apps to bolt on, no add-ons to buy — just the stuff a working musician actually uses. These are real screens from the flagship.</p>
      </div>
    </div>

    <div class="proof-wrap">
      <ul class="proof" data-proof tabindex="0" aria-label="Screens from the flagship theme, scroll sideways">
        {proof.map((p, i) => (
          <li class="proof__item" style={`--i:${i}`}>
            <figure>
              <img src={p.src} alt={`${p.label}: ${p.note}`} width="1400" height="875" loading="lazy" decoding="async" />
              <figcaption><span class="num-outline text-[1.1rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><b>{p.label}</b><span>{p.note}</span></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>

    <div class="max-w-[1180px] mx-auto px-5 sm:px-10 mt-[clamp(2.5rem,5vw,4rem)]">
      <ol class="spec-list grid md:grid-cols-2 md:gap-x-14">
        {features.map((f, i) => (
          <li class="reveal spec-row">
            <span class="spec-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h4 class="font-display text-[1.18rem] uppercase tracking-[.02em] text-paper">{f.name}</h4>
              <p class="text-muted text-[.9rem] mt-1 leading-[1.55]">{f.desc}</p>
            </div>
            <span class="spec-bar" aria-hidden="true"></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- STATEMENT -->
  <section id="about" class="bg-paper text-ink py-[clamp(4rem,9vw,7rem)] overflow-hidden">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-10">
      <p class="kicker">03 — Why one site</p>
      <h2 class="statement head-reveal mt-4">
        <span class="statement__o">One site.</span><br />
        <span class="statement__f">Your whole</span> <span class="statement__o">career.</span>
      </h2>
      <div class="grid md:grid-cols-2 gap-x-14 gap-y-6 mt-[clamp(2rem,4vw,3rem)] pt-8 border-t-2 border-ink/15">
        <p class="reveal text-[#3f3a4d] text-[1.08rem] leading-[1.65]">Most artists scatter everything across a link-in-bio, a separate merch store and a press-kit PDF. Riffride brings it together — music, merch, tour dates, press kit and links — on one professional site you build, customise and actually own.</p>
        <p class="reveal d1 text-[#3f3a4d] text-[1.08rem] leading-[1.65]">No designers, no developers, no big budget. Connect it to Spotify and your merch shows right on your artist profile. Fill in your bio and links once and Google can build your artist panel from the structured data the theme writes for you.</p>
      </div>
    </div>
  </section>

  <!-- FAQ — a ruled index, not boxes -->
  <section id="faq" class="bg-paper-2 py-[clamp(3.5rem,8vw,6rem)]">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-10 grid md:grid-cols-[.8fr_1.2fr] gap-x-14 gap-y-8">
      <div>
        <p class="kicker">04 — Questions</p>
        <h2 class="head-reveal font-funk text-[clamp(1.8rem,4.4vw,3rem)] leading-[1.02] mt-3">Before you <span class="text-spot">ask</span></h2>
        <p class="reveal text-muted mt-4 max-w-[34ch] leading-[1.6]">The step-by-step lives in the help guides — menus, pages, merch and Spotify, in plain English.</p>
        <a href="/help" class="btn btn-spot mt-6">Browse the setup guides</a>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details class="reveal" open={i === 0}>
            <summary><span class="num-outline faq__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{f.q}</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Base>
