---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Page not found — Riffride" description="That page skipped a beat. Head back to the Riffride themes.">
  <Header />
  <section class="relative overflow-hidden grid place-items-center min-h-[62vh] py-[clamp(3rem,8vw,6rem)] bg-paper">
    <div class="reveal in max-w-[680px] mx-auto px-5 text-center relative z-[2]">
      <p class="kicker justify-center">404 — not found</p>
      <h1 class="font-funk text-[clamp(2rem,5.5vw,3.6rem)] leading-[1.03]" style="text-shadow:4px 4px 0 var(--color-spot)">This page <span class="text-spot" style="text-shadow:4px 4px 0 var(--color-ink)">skipped a beat</span></h1>
      <p class="mt-5 text-muted text-[1.05rem]">It's not here — maybe it never was, maybe it's on tour. Either way, the good stuff is this way:</p>
      <div class="flex flex-wrap gap-3.5 justify-center mt-8">
        <a href="/" class="btn btn-spot">Back home</a>
        <a href="/#templates" class="btn btn-ghost">See the themes</a>
      </div>
    </div>
  </section>
  <Footer />
</Base>
