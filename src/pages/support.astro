---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Support — Riffride"
  description="Get help with your Riffride theme — setup questions, bug reports and feature requests. We reply within two business days."
>
  <Header />

  <section class="page-intro py-[clamp(3rem,7vw,5rem)]">
    <div class="max-w-[1180px] mx-auto px-5 sm:px-10 page-intro__grid">
      <div class="reveal in">
        <p class="kicker">Support</p>
        <h1>How can we <span class="text-purple">help?</span></h1>
      </div>
      <p class="reveal in page-intro__lead">Check the <a href="/help" class="text-cream font-semibold underline underline-offset-4 decoration-purple">setup guides</a> first — most questions are answered there. Otherwise, drop us a message and we'll reply within two business days.</p>
    </div>
  </section>

  <section class="bg-cream text-ink py-[clamp(3rem,7vw,5rem)]">
    <div class="reveal max-w-[560px] mx-auto px-5 sm:px-10">
      <form action="https://formsubmit.co/james.keane@dittomusic.com" method="POST" class="grid gap-4">
        <input type="hidden" name="_subject" value="Riffride support request">
        <input type="hidden" name="_captcha" value="true">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        <label class="field">
          <span>Your name</span>
          <input required type="text" name="name" autocomplete="name" />
        </label>
        <label class="field">
          <span>Email</span>
          <input required type="email" name="email" autocomplete="email" />
        </label>
        <label class="field">
          <span>Which theme?</span>
          <select name="theme">
            <option>Riffride (Theme Store)</option>
            <option>Standard (free)</option>
            <option>Vesper</option><option>Riot</option><option>Static</option>
            <option>Wander</option><option>Block</option><option>Frame</option>
            <option>Not sure</option>
          </select>
        </label>
        <label class="field">
          <span>How can we help?</span>
          <textarea required name="message" rows="6"></textarea>
        </label>
        <button type="submit" class="btn btn-purple justify-self-start">Send message</button>
        <p class="text-[#625b70] text-[.78rem]">We use your details only to reply to this request.</p>
      </form>
    </div>
  </section>

  <Footer />
</Base>
